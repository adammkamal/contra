# Copy to .env.local (gitignored) and fill in. Contra reads ONLY these names.
# Do not use ANTHROPIC_API_KEY / ANTHROPIC_MODEL: Claude Code reads those too.
CONTRA_ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) or claude-fable-5-1; keep whichever passes npm run extract:live 5/5
CONTRA_MODEL=claude-opus-5-5
